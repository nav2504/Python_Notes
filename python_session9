# 15. @classmethod
# ============================================================

class Employee:

    company = "ABC Corp"

    def __init__(self, name, salary):
        self.name = name
        self.salary = salary

    @classmethod
    def get_company(cls):
        return cls.company


employee1 = Employee("Naveen", 100000)

print(employee1.name)
print(employee1.salary)

print(Employee.get_company())

# ABC Corp


# self
#   -> current object
#
# cls
#   -> current class


# ============================================================
# 16. CLASS METHOD AS ALTERNATIVE CONSTRUCTOR
# ============================================================

class Product:

    def __init__(self, name, price):
        self.name = name
        self.price = price

    @classmethod
    def from_string(cls, product_string):

        name, price = product_string.split("-")

        return cls(name, int(price))


product1 = Product.from_string("Laptop-1200")

print(product1.name)
# Laptop

print(product1.price)
# 1200


# Normal constructor:
#
# Product("Laptop", 1200)
#
#
# Alternative constructor:
#
# Product.from_string("Laptop-1200")
#
#
# Important:
#
# cls(...)
#
# creates an object of the current class.


# ============================================================
# 17. @staticmethod
# ============================================================

class Product:

    def __init__(self, name, price):
        self.name = name
        self.price = price

    @staticmethod
    def is_valid_price(price):
        return price >= 0


print(Product.is_valid_price(1200))
# True

print(Product.is_valid_price(-500))
# False

print(Product.is_valid_price(0))
# True


# Static method:
#
# - Does not automatically receive self
# - Does not automatically receive cls
# - Usually performs a utility or validation operation
#   related to the class.


# ============================================================
# INSTANCE vs CLASS vs STATIC METHODS
# ============================================================

# INSTANCE METHOD
#
# def method(self):
#     ...
#
# Works with a particular object.
#
# Example:
#
# self.salary


# CLASS METHOD
#
# @classmethod
# def method(cls):
#     ...
#
# Works with the class.
#
# Example:
#
# cls.company


# STATIC METHOD
#
# @staticmethod
# def method(value):
#     ...
#
# Doesn't need the object or class.


# Shortcut:
#
# Need object data?
#     -> self
#
# Need class data?
#     -> cls
#
# Need neither?
#     -> @staticmethod


# ============================================================
# 18. COMPOSITION — HAS-A RELATIONSHIP
# ============================================================

class Address:

    def __init__(self, city, state):
        self.city = city
        self.state = state


class Employee:

    def __init__(self, name, address):
        self.name = name
        self.address = address


address1 = Address("Dallas", "Texas")

employee1 = Employee("Naveen", address1)


print(employee1.name)
# Naveen

print(employee1.address.city)
# Dallas

print(employee1.address.state)
# Texas


# Relationship:
#
# Employee HAS-A Address
#
#
# employee1
#     |
#     +-- address
#            |
#            +-- city
#            |
#            +-- state


# Inheritance:
#
# Manager IS-A Employee
#
#
# Composition:
#
# Employee HAS-A Address


# ============================================================
# 19. MULTIPLE INHERITANCE
# ============================================================

class Employee:

    def get_role(self):
        return "Employee"


class Student:

    def get_role(self):
        return "Student"


class Intern(Employee, Student):
    pass


intern1 = Intern()

print(intern1.get_role())

# Employee


# Intern inherits from TWO classes:
#
# Employee
# Student


# ============================================================
# 20. MRO — METHOD RESOLUTION ORDER
# ============================================================

print(Intern.mro())


# Conceptually:
#
# Intern
#   ↓
# Employee
#   ↓
# Student
#   ↓
# object
#
#
# When Python sees:
#
# intern1.get_role()
#
# it searches according to the MRO.
#
#
# Employee.get_role()
#
# is found before:
#
# Student.get_role()
#
# so:
#
# intern1.get_role()
#
# returns:
#
# Employee


# IMPORTANT:
#
# get_role()
#
# asks:
#
# "Run this method."
#
#
# mro()
#
# asks:
#
# "What order will Python search when looking
#  for methods/attributes?"


# ============================================================
# 21. ABSTRACT CLASSES
# ============================================================

from abc import ABC, abstractmethod


class Shape(ABC):

    @abstractmethod
    def calculate_area(self):
        pass


class Rectangle(Shape):

    def __init__(self, length, width):
        self.length = length
        self.width = width

    def calculate_area(self):
        return self.length * self.width


rectangle1 = Rectangle(10, 5)

print(rectangle1.calculate_area())

# 50


# Shape is an abstract class.
#
# Rectangle inherits Shape.
#
# Shape requires:
#
# calculate_area()
#
#
# Rectangle MUST implement it before Rectangle
# objects can be created.


# This would fail:
#
# class Rectangle(Shape):
#     pass
#
# rectangle1 = Rectangle()
#
#
# because calculate_area() is still abstract.


# ============================================================
# FINAL OOP COMBINED EXAMPLE
# ============================================================

from abc import ABC, abstractmethod


class Employee(ABC):

    # Class attribute
    company = "ABC Corp"


    # Constructor
    def __init__(self, name, salary):

        self.name = name
        self.salary = salary


    # Abstract method
    @abstractmethod
    def calculate_bonus(self):
        pass


    # Class method
    @classmethod
    def get_company(cls):

        return cls.company


    # Static method
    @staticmethod
    def is_valid_salary(salary):

        return salary >= 0


class Developer(Employee):

    # Polymorphism / implementation of abstract method
    def calculate_bonus(self):

        return self.salary * 0.08


class Manager(Employee):

    # Polymorphism / implementation of abstract method
    def calculate_bonus(self):

        return self.salary * 0.10


manager1 = Manager("Bob", 100000)

developer1 = Developer("Alice", 100000)


print(manager1.name)
# Bob

print(manager1.calculate_bonus())
# 10000.0


print(developer1.name)
# Alice

print(developer1.calculate_bonus())
# 8000.0


print(Employee.get_company())
# ABC Corp


print(Employee.is_valid_salary(100000))
# True

print(Employee.is_valid_salary(-500))
# False


