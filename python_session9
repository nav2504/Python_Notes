# ============================================================
# METHOD TYPE DECISION
# ============================================================

# Does the method need data from a specific object?
#
# YES
#   -> instance method
#   -> self
#
#
# Does the method need class-level data?
#
# YES
#   -> @classmethod
#   -> cls
#
#
# Does it need neither object data nor class data?
#
# YES
#   -> @staticmethod


# ============================================================
# __init__ IN INHERITANCE
# ============================================================

# If the child needs exactly the same initialization
# as the parent:
#
# DON'T write another __init__.
#
#
# Example:
#
# class Employee:
#
#     def __init__(self, name, salary):
#         self.name = name
#         self.salary = salary
#
#
# class Manager(Employee):
#     pass
#
#
# Manager automatically inherits Employee.__init__.


# If the child needs EXTRA initialization:
#
# Write the child's __init__ and use super().
#
#
# class Manager(Employee):
#
#     def __init__(self, name, salary, team_size):
#
#         super().__init__(name, salary)
#
#         self.team_size = team_size


