# ============================================================
# 1. CLASS AND OBJECT
# ============================================================

# A class is a blueprint.
# An object is an instance of that class.

class Employee:

    def __init__(self, name, department, salary):
        self.name = name
        self.department = department
        self.salary = salary


employee1 = Employee("Naveen", "IT", 100000)

print(employee1.name)
print(employee1.department)
print(employee1.salary)


# ------------------------------------------------------------
# KEY POINTS
# ------------------------------------------------------------

# __init__()
#   - Called automatically when an object is created.
#
# self
#   - Represents the current object.
#
# self.name
# self.department
# self.salary
#   - Instance attributes.


# ============================================================
# 2. INSTANCE METHODS
# ============================================================

class Employee:

    def __init__(self, name, salary):
        self.name = name
        self.salary = salary

    def give_raise(self, amount):
        self.salary += amount


employee1 = Employee("Naveen", 100000)

employee1.give_raise(10000)

print(employee1.salary)
# 110000


# Instance methods normally receive:
#
# self
#
# They can read or modify the current object's data.


# ============================================================
# 3. METHODS THAT RETURN VALUES
# ============================================================

class Employee:

    def __init__(self, name, salary):
        self.name = name
        self.salary = salary

    def get_annual_bonus(self, percentage):
        return self.salary * percentage / 100


employee1 = Employee("Naveen", 100000)

bonus = employee1.get_annual_bonus(10)

print(bonus)
# 10000.0


# ============================================================
# 4. MULTIPLE OBJECTS ARE INDEPENDENT
# ============================================================

class Employee:

    def __init__(self, name, department, salary):
        self.name = name
        self.department = department
        self.salary = salary

    def give_raise(self, amount):
        self.salary += amount

    def get_annual_bonus(self, percentage):
        return self.salary * percentage / 100


employee1 = Employee("Naveen", "IT", 100000)
employee2 = Employee("Alice", "Finance", 80000)

employee1.give_raise(10000)
employee2.give_raise(5000)

print(employee1.salary)
# 110000

print(employee2.salary)
# 85000

print(employee1.get_annual_bonus(10))
# 11000.0

print(employee2.get_annual_bonus(5))
# 4250.0


# Each object has its own instance attributes.


# ============================================================
# 5. CLASS ATTRIBUTES VS INSTANCE ATTRIBUTES
# ============================================================

class BankAccount:

    # Class attribute
    # Shared conceptually by all BankAccount objects.
    bank_name = "ABC Bank"

    def __init__(self, account_holder, balance):

        # Instance attributes
        self.account_holder = account_holder
        self.balance = balance


account1 = BankAccount("Naveen", 5000)
account2 = BankAccount("Alice", 8000)

print(account1.account_holder)
print(account1.balance)

print(account2.account_holder)
print(account2.balance)

print(BankAccount.bank_name)


# Class attribute:
#
# BankAccount.bank_name
#
# Instance attributes:
#
# account1.account_holder
# account1.balance


# ============================================================
# 6. METHODS THAT MODIFY OBJECT STATE + VALIDATION
# ============================================================

class BankAccount:

    bank_name = "ABC Bank"

    def __init__(self, account_holder, balance):
        self.account_holder = account_holder
        self.balance = balance

    def deposit(self, amount):
        self.balance += amount
        return "Deposit successful"

    def withdraw(self, amount):

        if amount <= self.balance:
            self.balance -= amount
            return "Withdrawal successful"

        return "Insufficient balance"


account1 = BankAccount("Naveen", 5000)

print(account1.deposit(2000))
print(account1.withdraw(1000))

print(account1.balance)
# 6000


# ============================================================
# 7. __str__()
# ============================================================

# __str__() controls how an object is displayed by print().

class Product:

    def __init__(self, name, price, quantity):
        self.name = name
        self.price = price
        self.quantity = quantity

    def __str__(self):
        return f"{self.name} - ${self.price} - Quantity: {self.quantity}"


product1 = Product("Laptop", 1200, 2)

print(product1)

# Laptop - $1200 - Quantity: 2


# __str__() MUST return a string.


# ============================================================
# 8. ENCAPSULATION
# ============================================================

# Public attribute:
#
# self.balance
#
# Internal-use convention:
#
# self._balance
#
# Name-mangled attribute:
#
# self.__balance


class BankAccount:

    def __init__(self, account_holder, balance):
        self.account_holder = account_holder
        self.__balance = balance

    def get_balance(self):
        return self.__balance

    def deposit(self, amount):
        self.__balance += amount


account1 = BankAccount("Naveen", 5000)

account1.deposit(2000)

print(account1.get_balance())
# 7000


# Normally this will NOT work:
#
# account1.__balance
#
# Python performs name mangling.
#
# Internally it is approximately:
#
# account1._BankAccount__balance
#
# IMPORTANT:
# __ does NOT provide absolute security.
# It mainly prevents accidental direct access.


# ============================================================
# 9. @property — GETTERS AND SETTERS
# ============================================================

class Product:

    def __init__(self, name, price):
        self.name = name
        self.__price = price

    @property
    def price(self):
        return self.__price

    @price.setter
    def price(self, new_price):

        if new_price >= 0:
            self.__price = new_price


product1 = Product("Laptop", 1200)

print(product1.price)
# 1200

product1.price = 1500

print(product1.price)
# 1500

product1.price = -500

print(product1.price)
# Still 1500


# @property allows:
#
# product1.price
#
# instead of:
#
# product1.get_price()
#
#
# @price.setter allows:
#
# product1.price = 1500
#
# while still running validation logic.


# ============================================================
# 10. BASIC INHERITANCE
# ============================================================

class Vehicle:

    def __init__(self, brand, year):
        self.brand = brand
        self.year = year

    def get_info(self):
        return f"{self.brand} - {self.year}"


class Car(Vehicle):
    pass


car1 = Car("Toyota", 2025)

print(car1.brand)
print(car1.year)
print(car1.get_info())


# Car inherits:
#
# Vehicle.__init__()
# Vehicle.get_info()
#
#
# Relationship:
#
# Car IS-A Vehicle


# ============================================================
# 11. super()
# ============================================================

# Use super() when the child needs its own initialization
# while also using parent initialization.


class Vehicle:

    def __init__(self, brand, year):
        self.brand = brand
        self.year = year


class Car(Vehicle):

    def __init__(self, brand, year, number_of_doors):

        super().__init__(brand, year)

        self.number_of_doors = number_of_doors


car1 = Car("Toyota", 2025, 4)

print(car1.brand)
print(car1.year)
print(car1.number_of_doors)


# IMPORTANT:
#
# Correct:
#
# super().__init__(brand, year)
#
#
# NOT:
#
# super().__init__(self, brand, year)
#
#
# self is passed automatically.


# ============================================================
# 12. METHOD OVERRIDING
# ============================================================

class Vehicle:

    def __init__(self, brand, year):
        self.brand = brand
        self.year = year

    def get_info(self):
        return f"{self.brand} - {self.year}"


class Car(Vehicle):

    def __init__(self, brand, year, number_of_doors):

        super().__init__(brand, year)

        self.number_of_doors = number_of_doors

    def get_info(self):

        base_info = super().get_info()

        return f"{base_info} - {self.number_of_doors} doors"


car1 = Car("Toyota", 2025, 4)

print(car1.get_info())

# Toyota - 2025 - 4 doors


# Child class overrides:
#
# Vehicle.get_info()
#
# with:
#
# Car.get_info()
#
#
# super().get_info()
#
# lets us reuse the parent's implementation.


# ============================================================
# 13. POLYMORPHISM
# ============================================================

class Employee:

    def __init__(self, name, salary):
        self.name = name
        self.salary = salary

    def calculate_bonus(self):
        return self.salary * 0.05


class Manager(Employee):

    def calculate_bonus(self):
        return self.salary * 0.10


class Developer(Employee):

    def calculate_bonus(self):
        return self.salary * 0.08


employees = [

    Employee("Alice", 100000),

    Manager("Bob", 100000),

    Developer("Charlie", 100000)

]


for employee in employees:

    print(
        f"{employee.name} -> "
        f"{employee.calculate_bonus()}"
    )


# Alice -> 5000.0
# Bob -> 10000.0
# Charlie -> 8000.0


# Same method call:
#
# employee.calculate_bonus()
#
# Different behavior depending on the object.
#
# This is polymorphism.


# ============================================================
# 14. isinstance() AND issubclass()
# ============================================================

manager1 = Manager("Bob", 100000)


print(isinstance(manager1, Manager))
# True

print(isinstance(manager1, Employee))
# True

print(isinstance(manager1, Developer))
# False


print(issubclass(Manager, Employee))
# True

print(issubclass(Developer, Employee))
# True

print(issubclass(Employee, Manager))
# False


# Easy distinction:
#
# isinstance(object, class)
#
# issubclass(class, class)


