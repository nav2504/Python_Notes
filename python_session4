)

# ["NAVEEN", "SARAH", "JOHN", "LISA"]


# ============================================================
# 16. map() + CALCULATION
# ============================================================

employee_new_salary = list(
    map(
        lambda employee:
            employee["salary"] +
            (employee["salary"] * 0.10),
        employees
    )
)

