# ============================================================
# 17. filter()
# ============================================================
# filter() SELECTS items.
#
# General pattern:
#
# list(filter(lambda item: condition, collection))


numbers = [10, 15, 20, 25, 30, 35, 40]

even_numbers = list(
    filter(
        lambda number: number % 2 == 0,
        numbers
    )
)

# [10, 20, 30, 40]


# ============================================================
# 18. filter() + DICTIONARIES
# ============================================================

employees = [
    {"name": "Naveen", "department": "Technology", "salary": 100000},
    {"name": "Sarah", "department": "Finance", "salary": 120000},
    {"name": "John", "department": "Technology", "salary": 90000},
    {"name": "Lisa", "department": "HR", "salary": 110000}
]


high_earners = list(
    filter(
        lambda employee: employee["salary"] >= 100000,
        employees
    )
)


# ============================================================
# 19. filter() + MULTIPLE CONDITIONS
# ============================================================

tech_high_earners = list(
    filter(
        lambda employee:
            employee["salary"] >= 100000
            and employee["department"] == "Technology",
        employees
    )
)


# ============================================================
# 20. map() + filter() TOGETHER
# ============================================================
# FILTER first → MAP second
#
# Filter qualifying employees
# Then transform them.


tech_names = list(
    map(
        lambda employee: employee["name"].upper(),

        filter(
            lambda employee:
                employee["salary"] >= 100000
                and employee["department"] == "Technology",

            employees
        )
    )
)

# ["NAVEEN"]


# ============================================================
# 21. filter() + map() + CALCULATION
# ============================================================

tech_salary_after_raise = list(
    map(
        lambda employee:
            employee["salary"] +
            (employee["salary"] * 0.10),

        filter(
            lambda employee:
                employee["department"] == "Technology"
                and employee["salary"] >= 90000,

            employees
        )
    )
)

# [110000.0, 99000.0]


# ============================================================
# 22. sorted()
# ============================================================
# sorted() returns a NEW sorted list.
#
# Ascending order:

numbers = [40, 10, 30, 20, 50]

sorted(numbers)

# [10, 20, 30, 40, 50]


# Descending:

sorted(numbers, reverse=True)

# [50, 40, 30, 20, 10]


# ============================================================
# 23. sorted() + key + lambda
# ============================================================

employees_by_salary = sorted(
    employees,
    key=lambda employee: employee["salary"]
)


# Highest salary first:

employees_by_salary = sorted(
    employees,
    key=lambda employee: employee["salary"],
    reverse=True
)


# ============================================================
# 24. map() vs filter() vs sorted()
# ============================================================

# map()
# → TRANSFORM

list(map(lambda x: x * 2, numbers))


# filter()
# → SELECT / KEEP

list(filter(lambda x: x % 2 == 0, numbers))


# sorted()
# → ORDER

sorted(numbers)


# Easy memory trick:
#
# map    = MODIFY
# filter = FIND / KEEP
# sorted = ORDER


# ============================================================
# 25. COMBINING sorted() + filter() + map()
# ============================================================

top_earners = list(
    map(
        lambda employee: employee["name"].upper(),

        filter(
            lambda employee:
                employee["salary"] >= 100000,

            sorted(
                employees,
                key=lambda employee: employee["salary"],
                reverse=True
            )
        )
    )
)

# ["SARAH", "LISA", "NAVEEN"]


# ============================================================
# 26. IMPORTANT: READ COMPLEX EXPRESSIONS INSIDE → OUT
# ============================================================

# Example:

list(
    map(
        lambda employee: employee["name"].upper(),

        filter(
            lambda employee: employee["salary"] >= 100000,

            sorted(
                employees,
                key=lambda employee: employee["salary"],
                reverse=True
            )
        )
    )
)


# Read it:
#
# 1. sorted()
#       ↓
#    sort employees
#
# 2. filter()
#       ↓
#    keep salary >= 100000
#
# 3. map()
#       ↓
#    extract + uppercase name
#
