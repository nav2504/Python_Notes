# ------------------------------------------------------------
# Challenge 74 — Department Average Salary
# ------------------------------------------------------------

def department_average_salary(employees):
    average_salary_dep = {}
    employee_count = {}
    total_salary = {}

    if not employees:
        return "No employees"

    for employee in employees:
        if "department" not in employee:
            return "Department is missing"

        if "salary" not in employee:
            return "Salary is missing"

        if not isinstance(employee["salary"], (int, float)):
            return "Invalid salary"

        department = employee["department"]
        salary = employee["salary"]

        if department in total_salary:
            total_salary[department] += salary
            employee_count[department] += 1
        else:
            total_salary[department] = salary
            employee_count[department] = 1

    for department in total_salary:
        average_salary_dep[department] = (
            total_salary[department] / employee_count[department]
        )

    return average_salary_dep


