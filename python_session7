# ------------------------------------------------------------
# Challenge 70 — Give Raise
# ------------------------------------------------------------

def give_raise(employees, percentage):
    if not employees:
        return "No employees"

    for employee in employees:
        if "salary" not in employee:
            return "Salary is missing"

        if isinstance(employee["salary"], (int, float)):
            employee["salary"] = employee["salary"] * (1 + percentage / 100)
        else:
            return "Invalid salary"

    return employees


