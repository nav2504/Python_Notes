# ------------------------------------------------------------
# Challenge 77 — Department Summary
# ------------------------------------------------------------

def department_summary(employees):
    department_details = {}

    if not employees:
        return "No employees"

    for employee in employees:
        if "department" not in employee:
            return "Department is missing"

        if "salary" not in employee:
            return "Salary is missing"

        if not isinstance(employee["salary"], (int, float)):
            return "Invalid salary"

        department = employee["department"]
        salary = employee["salary"]

        if department not in department_details:
            count = 1

            department_details[department] = {
                "count": count,
                "total_salary": salary
            }

        else:
            count = department_details[department]["count"] + 1
            total_salary = (
                department_details[department]["total_salary"] + salary
            )

            department_details[department] = {
                "count": count,
                "total_salary": total_salary
            }

    for each_department in department_details:
        department_details[each_department]["average_salary"] = (
            department_details[each_department]["total_salary"]
            / department_details[each_department]["count"]
        )

    return department_details


# ------------------------------------------------------------
# Challenge 78 — Sort Employees by Salary
# ------------------------------------------------------------

def sort_employees_by_salary(employees):
    if not employees:
        return "No employees"

    for employee in employees:
        if "salary" not in employee:
            return "Salary is missing"

        if not isinstance(employee["salary"], (int, float)):
            return "Invalid salary"

    employee_salary = sorted(
        employees,
        key=lambda employee: employee["salary"],
        reverse=True
    )

    return employee_salary


# ------------------------------------------------------------
# Challenge 79 — Filter Employees by Minimum Salary
# ------------------------------------------------------------

def filter_employees_by_salary(employees, minimum_salary):
    if not employees:
        return "No employees"

    for employee in employees:
        if "salary" not in employee:
            return "Salary is missing"

        if not isinstance(employee["salary"], (int, float)):
            return "Invalid salary"

    filter_salary = list(
        filter(
            lambda employee: employee["salary"] >= minimum_salary,
            employees
        )
    )

    return filter_salary


# ------------------------------------------------------------
# Challenge 80 — Format Employees using map()
# ------------------------------------------------------------

def format_employees(employees):
    if not employees:
        return "No employees"

    for employee in employees:
        if "name" not in employee:
            return "Name is missing"

        if "salary" not in employee:
            return "Salary is missing"

        if not isinstance(employee["salary"], (int, float)):
            return "Invalid salary"

    formatted_employees = list(
        map(
            lambda employee: f"{employee['name']} - ${employee['salary']}",
            employees
        )
    )

    return formatted_employees


