def top_earners_by_department(employees, minimum_salary):
    if not employees:
        return "No employees"

    for employee in employees:
        if "name" not in employee:
            return "Name is missing"

        if "department" not in employee:
            return "Department is missing"

        if "salary" not in employee:
            return "Salary is missing"

        if not isinstance(employee["salary"], (int, float)):
            return "Invalid salary"

    filter_employee = list(
        filter(
            lambda employee: employee["salary"] >= minimum_salary,
            employees
        )
    )

    sorted_employee = sorted(
        filter_employee,
        key=lambda employee: employee["salary"],
        reverse=True
    )

    return sorted_employee


