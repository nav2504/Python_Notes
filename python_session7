# ------------------------------------------------------------
# Challenge 65 — Find Employee by Name
# ------------------------------------------------------------

def find_employee(employees, name):
    for employee in employees:
        if "name" not in employee:
            return "Name is missing"

        if employee["name"] == name:
            return employee

    return "Employee not found"


# ------------------------------------------------------------
# Challenge 66 — Find Employees by Department
# ------------------------------------------------------------

def find_employees_by_department(employees, department):
    result = []

    for employee in employees:
        if "department" not in employee:
            return "Department is missing"

        if employee["department"] == department:
            result.append(employee)

    if not result:
        return "No employees found"

    return result


# ------------------------------------------------------------
# Challenge 67 — Calculate Average Salary
# ------------------------------------------------------------

def calculate_average_salary(employees):
    total_emp = 0
    total_salary = 0

    if not employees:
        return "No employees"

    for employee in employees:
        if "salary" not in employee:
            return "Salary is missing"

        if isinstance(employee["salary"], (int, float)):
            total_emp += 1
            total_salary += employee["salary"]
        else:
            return "Invalid salary"

    average_salary = total_salary / total_emp
    return average_salary


# ------------------------------------------------------------
# Challenge 68 — Find Highest-Paid Employee
# ------------------------------------------------------------

def find_highest_paid_employee(employees):
    highest_employee = {}
    count = 0

    if not employees:
        return "No employees"

    for employee in employees:
        if "salary" not in employee:
            return "Salary is missing"

        if isinstance(employee["salary"], (int, float)):
            if count == 0:
                highest_salary = employee["salary"]
                highest_employee = employee
                count += 1

            elif highest_salary < employee["salary"]:
                highest_salary = employee["salary"]
                highest_employee = employee
        else:
            return "Invalid salary"

    return highest_employee


