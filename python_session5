# ============================================================
# 13. FILE vs DIRECTORY
# ============================================================

import os

def identify_path(path):

    if os.path.isfile(path):
        return "File"

    elif os.path.isdir(path):
        return "Directory"

    else:
        return "Does not exist"


# ============================================================
# 14. sys MODULE
# ============================================================

import sys

sys.argv


# sys.argv contains command-line arguments.

# Example command:

# python main.py Naveen 35


# sys.argv conceptually becomes:

# ["main.py", "Naveen", "35"]


# Important:

# sys.argv[0] → script name
# sys.argv[1] → first argument
# sys.argv[2] → second argument


# ============================================================
# 15. ACCESSING COMMAND-LINE ARGUMENTS
# ============================================================

import sys

def get_first_argument():
    return sys.argv[1]


# ============================================================
# 16. sys.argv + TYPE CONVERSION
# ============================================================

import sys

def get_user_details():
    return {
        "name": sys.argv[1],
        "age": int(sys.argv[2])
    }


# Remember:
# sys.argv values are STRINGS.

# Example:
# sys.argv[2] → "35"

# Convert:
# int(sys.argv[2]) → 35


# ============================================================
# 17. sys.argv + EXCEPTION HANDLING
# ============================================================

import sys

def get_user_details():

    try:
        age = int(sys.argv[2])
        name = sys.argv[1]

        return {
            "name": name,
            "age": age
        }

    except IndexError:
        return "Name and age are required"

    except ValueError:
        return "Age must be a number"


# ============================================================
# 18. COMBINING MODULES + CALCULATIONS + EXCEPTIONS
# ============================================================

import sys

def process_employee():

    try:
        name = sys.argv[1]
        salary = float(sys.argv[2])

        final_salary = salary * 1.10

        return {
            "name": name,
            "salary": final_salary
        }

    except IndexError:
        return "Name and salary are required"

    except ValueError:
        return "Salary must be a number"


