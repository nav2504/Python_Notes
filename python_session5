# 9. datetime FORMATTING
# ============================================================

now = datetime.now()

now.strftime("%Y-%m-%d")

# Example:
# "2026-08-31"


# Date + time:

now.strftime("%Y-%m-%d %H:%M:%S")

# Example:
# "2026-08-31 10:30:45"


# Important format codes:

# %Y → 4-digit year
# %m → 2-digit month
# %d → day
# %H → hour (24-hour)
# %M → minute
# %S → second


# ============================================================
# 10. random MODULE
# ============================================================

import random


# Random integer INCLUDING both boundaries:

random.randint(1000, 9999)


# Randomly select ONE item:

departments = ["Technology", "Finance", "HR", "Marketing"]

random.choice(departments)


# Randomly select MULTIPLE UNIQUE items:

random.sample(departments, 2)


# Difference:

# randint()  → random number
# choice()   → one random item
# sample()   → multiple unique items


