# ============================================================
# 21. CONCEPTS YOU SHOULD BE ABLE TO EXPLAIN
# ============================================================

# What is a module?
# → A Python file containing reusable code.

# Why use modules?
# → Code organization, reuse, and maintainability.

# import math
# → Import the entire math module.

# from math import sqrt
# → Import only sqrt.

# import math as m
# → Give math a shorter local name.

# sys.argv
# → Command-line arguments.

# sys.argv[0]
# → Script name.

# sys.argv[1]
# → First user-provided argument.

# Why convert sys.argv values?
# → Because command-line arguments are strings.

# os.getcwd()
# → Current working directory.

# os.listdir()
# → Directory contents.

# os.path.exists()
# → Whether a path exists.

# os.path.isfile()
# → Whether a path is a file.

# os.path.isdir()
# → Whether a path is a directory.

# os.path.join()
# → Safely build a file/path string.


