# ============================================================
# 1. MODULES
# ============================================================

# A module is a Python file (.py) containing reusable code.

# Example:
# employee_utils.py

def calculate_bonus(salary):
    return salary * 0.10


# Another Python file can import the function:

from employee_utils import calculate_bonus

bonus = calculate_bonus(100000)


# ============================================================
# 2. IMPORTING AN ENTIRE MODULE
# ============================================================

import employee_utils

employee_utils.calculate_bonus(100000)


# Module name is used to access its functions:
# module_name.function_name()


# ============================================================
# 3. IMPORTING SPECIFIC FUNCTIONS
# ============================================================

from employee_utils import calculate_bonus, calculate_tax

bonus = calculate_bonus(100000)
tax = calculate_tax(100000)


# ============================================================
# 4. MODULE ALIAS
# ============================================================

import math as m

result = m.pow(2, 5)

# m is now an alias for math


# ============================================================
# 5. FUNCTION ALIAS
# ============================================================

from employee_utils import calculate_bonus as bonus

result = bonus(100000)

# calculate_bonus is now available locally as bonus


# ============================================================
# 6. CUSTOM MODULE EXAMPLE
# ============================================================

# employee_utils.py

def calculate_bonus(salary):
    return salary * 0.10

def calculate_tax(salary):
    return salary * 0.20


# main.py

import employee_utils

def calculate_take_home_salary(salary):
    bonus = employee_utils.calculate_bonus(salary)
    tax = employee_utils.calculate_tax(salary)

    gross_salary = salary + bonus
    take_home = gross_salary - tax

    return take_home


