# ============================================================
# 01. ITERABLE VS ITERATOR
# ============================================================

# ITERABLE:
# An object that can provide an iterator.
#
# Examples:
# list, tuple, string, dictionary, set, range
#
# ITERATOR:
# An object that returns elements one at a time using next().
#
# An iterator implements:
# __iter__()
# __next__()
#
# Iterators remember their current position.

numbers = [10, 20, 30]

iterator = iter(numbers)

print(next(iterator))  # 10
print(next(iterator))  # 20
print(next(iterator))  # 30

# Important:
# A list is iterable but is not itself an iterator.
# iter(list) creates an iterator.


# ============================================================
# 02. iter(), next(), StopIteration
# ============================================================

# iter(iterable):
# Returns an iterator.
#
# next(iterator):
# Returns the next available element.
#
# If no elements remain, next() raises StopIteration.

numbers = [5, 10]

iterator = iter(numbers)

print(next(iterator))  # 5
print(next(iterator))  # 10

try:
    print(next(iterator))
except StopIteration:
    print("Iterator exhausted")

# OUTPUT:
# 5
# 10
# Iterator exhausted


