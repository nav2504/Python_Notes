# Find all .txt files recursively
# and copy them into a backup directory.


# ------------------------------------------------------------
# Challenge 112 - Backup Text Files
# ------------------------------------------------------------

def backup_text_files(
    source_directory,
    backup_directory
):
    source = Path(source_directory)
    backup = Path(backup_directory)

    count = 0

    if not source.exists():
        return "Source directory not found"

    if not source.is_dir():
        return "Source is not a directory"

    if backup.exists() and not backup.is_dir():
        return "Backup is not a directory"

    if not backup.exists():
        backup.mkdir(
            parents=True,
            exist_ok=True
        )

    for file in source.rglob("*.txt"):

        if file.is_file():

            shutil.copy(
                file,
                backup / file.name
            )

            count += 1

    return count


