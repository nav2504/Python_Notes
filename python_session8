import tempfile

# NamedTemporaryFile creates a temporary file.
#
# delete=False means:
# keep the file after closing it.
#
# The program becomes responsible for cleanup.


# ------------------------------------------------------------
# Challenge 111 - Create Temporary File
# ------------------------------------------------------------

def create_temp_file(content):

    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        delete=False
    ) as temp:

        temp.write(content)

    return temp.name


