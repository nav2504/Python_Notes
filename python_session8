# 9. RECURSIVE FILE SEARCHING
# ============================================================

# iterdir()
#     -> immediate directory only
#
# glob()
#     -> pattern matching in current directory
#
# rglob()
#     -> recursive pattern matching


# ------------------------------------------------------------
# Challenge 97 - List All Files Recursively
# ------------------------------------------------------------

def list_all_files(directory):
    path_obj = Path(directory)
    result = []

    if not path_obj.exists():
        return "Directory not found"

    if not path_obj.is_dir():
        return "Not a directory"

    for item in path_obj.rglob("*"):

        if item.is_file():
            result.append(str(item))

    return result


# ------------------------------------------------------------
# Challenge 98 - Find Files by Extension Recursively
# ------------------------------------------------------------

def find_files_by_extension(directory, extension):
    path_obj = Path(directory)
    result = []

    if not path_obj.exists():
        return "Directory not found"

    if not path_obj.is_dir():
        return "Not a directory"

    pattern = "*" + extension

    for item in path_obj.rglob(pattern):

        if item.is_file():
            result.append(str(item))

    return result


